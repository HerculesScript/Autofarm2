-- ============================================================
-- LÓGICA
-- ============================================================
local function findDeliveryGive()
    local deliveryQuest = Workspace:FindFirstChild("Delivery Quest", true) or Workspace:FindFirstChild("DeliveryQuest", true) or Workspace:FindFirstChild("Delivery", true)
    if deliveryQuest then
        local givePart = deliveryQuest:FindFirstChild("Give", true)
        if givePart and givePart:IsA("BasePart") then return givePart end
        local point = deliveryQuest:FindFirstChild("Delivery Point", true) or deliveryQuest:FindFirstChild("DeliveryPoint", true)
        if point then return point:IsA("BasePart") and point or point:FindFirstChildWhichIsA("BasePart", true) end
    end
    return Workspace:FindFirstChild("Give", true)
end

local function farmLoop()
    while farming do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            statusText.Text = "Procurando caixa..."
            statusText.TextColor3 = Color3.fromRGB(255, 180, 60)
            
            local clickPart = Workspace:FindFirstChild("ClickPart", true)
            
            if clickPart then
                statusText.Text = "Pegando caixa..."
                statusText.TextColor3 = Color3.fromRGB(120, 220, 120)
                
                local targetPos = clickPart.CFrame * CFrame.new(0, 2, -3)
                char:PivotTo(targetPos)
                task.wait(0.5)
                
                local clickDetector = clickPart:FindFirstChildWhichIsA("ClickDetector") or clickPart:FindFirstChildWhichIsA("ClickDetector", true)
                if clickDetector then
                    pcall(function() fireclickdetector(clickDetector) end)
                    task.wait(0.2)
                    pcall(function() fireclickdetector(clickDetector) end) 
                end
                
                task.wait(2) -- Espera o Give aparecer
                
                statusText.Text = "Procurando destino..."
                statusText.TextColor3 = Color3.fromRGB(255, 180, 60)
                
                local deliveryPart = findDeliveryGive()
                
                if deliveryPart then
                    statusText.Text = "Entregando (Física)..."
                    statusText.TextColor3 = Color3.fromRGB(120, 220, 120)
                    
                    -- 1. Sai do círculo
                    local outCFrame = deliveryPart.CFrame * CFrame.new(0, 2, 5)
                    char:PivotTo(outCFrame)
                    task.wait(0.3)
                    
                    -- 2. Entra no círculo
                    local inCFrame = CFrame.new(deliveryPart.Position.X, deliveryPart.Position.Y + 3, deliveryPart.Position.Z)
                    char:PivotTo(inCFrame)
                    
                    -- 3. Trava no chão
                    local startTime = tick()
                    while tick() - startTime < 2 and farming do
                        if char and char:FindFirstChild("HumanoidRootPart") then
                            char.HumanoidRootPart.CFrame = inCFrame
                        end
                        task.wait(0.1)
                    end
                    
                    task.wait(1)
                else
                    statusText.Text = "Destino não gerado."
                    statusText.TextColor3 = Color3.fromRGB(255, 80, 80)
                    task.wait(1)
                end
            else
                statusText.Text = "Caixa não encontrada."
                statusText.TextColor3 = Color3.fromRGB(255, 80, 80)
                task.wait(1)
            end
        end
        task.wait(0.5)
    end
end

toggleBtn.MouseButton1Click:Connect(function()
    farming = not farming
    if farming then
        toggleBtn.Text = "PARAR FARM"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
